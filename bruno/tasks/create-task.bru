meta {
  name: Create task
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/tasks
  body: json
  auth: bearer
}

auth:bearer {
  token: {{process.env.ACCESS_TOKEN}}
}

body:json {
  {
    "title": "Review pull request",
    "description": "Check module boundaries and response mapping"
  }
}

assert {
  res.status: eq 201
  res.body.id: isString
  res.body.isCompleted: eq false
}

script:post-response {
  bru.setVar("taskId", res.body.id);
}
